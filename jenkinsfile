pipeline {

  agent any

  environment {
    IMAGE_REPO = "mydocker3692/zepto"
  }

  stages {

    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Docker Login') {
      steps {
        withCredentials([usernamePassword(
          credentialsId: 'docker',
          usernameVariable: 'USER',
          passwordVariable: 'PASS'
        )]) {
          sh 'echo $PASS | docker login -u $USER --password-stdin'
        }
      }
    }

    stage('Build and Push (Parallel)') {

      parallel {

        stage('product-service') {
          steps {
            sh '''
            docker build -t $IMAGE_REPO:product-service-latest services/product-service
            docker push $IMAGE_REPO:product-service-latest
            '''
          }
        }

        stage('catalog-service') {
          steps {
            sh '''
            docker build -t $IMAGE_REPO:catalog-service-latest services/catalog-service
            docker push $IMAGE_REPO:catalog-service-latest
            '''
          }
        }

        stage('cart-service') {
          steps {
            sh '''
            docker build -t $IMAGE_REPO:cart-service-latest services/cart-service
            docker push $IMAGE_REPO:cart-service-latest
            '''
          }
        }

        stage('payment-service') {
          steps {
            sh '''
            docker build -t $IMAGE_REPO:payment-service-latest services/payment-service
            docker push $IMAGE_REPO:payment-service-latest
            '''
          }
        }

        stage('frontend') {
          steps {
            sh '''
            docker build -t $IMAGE_REPO:frontend-latest services/frontend
            docker push $IMAGE_REPO:frontend-latest
            '''
          }
        }

      }
    }

    stage('Deploy to Kubernetes') {
      steps {
        sh '''
        kubectl apply -R -f k8s/
        kubectl rollout restart deployment product
        kubectl rollout restart deployment catalog
        kubectl rollout restart deployment cart
        kubectl rollout restart deployment payment
        kubectl rollout restart deployment frontend
        '''
      }
    }

  }
}
